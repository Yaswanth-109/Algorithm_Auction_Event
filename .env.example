NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algorithm_auction?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
