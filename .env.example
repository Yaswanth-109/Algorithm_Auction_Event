JUDGE0_PYTHON_ID=71
JUDGE0_JAVA_ID=62
JUDGE0_C_ID=50
JUDGE0_CPP_ID=54
LOCAL_EXECUTION_IMAGE=algorithm-auction-runner:local
LOCAL_EXECUTION_TIMEOUT_MS=15000
SUBMISSION_CONCURRENCY=4
NEXT_PUBLIC_API_URL=http://localhost:4000
